# Copy to .env and fill in. NEVER commit your .env.
# ---------------------------------------------------------------------------
# Required
# the agents' brains (https://openrouter.ai). Every call is paid from the agents' own wallets.
OPENROUTER_API_KEY=
# used once to enroll your passkey / face on the HQ dashboard
DASHBOARD_PASSWORD=

# Identity of the company (shown on the shop, legal pages and in the agents' prompts)
COMPANY_NAME=AlphaPulse
COMPANY_LEGAL_NAME=Your Company LLC
# e.g. "City, State, Country" (mentions légales)
COMPANY_LEGAL_ADDRESS=
# e.g. "Hetzner Online GmbH, Gunzenhausen, Germany"
HOSTING_PROVIDER=
CONTACT_EMAIL=contact@example.com
COMPANY_WEBSITE=https://github.com/
# how the agents call you
OWNER_NAME=Owner

# Hosts: the dashboard (HQ) and the public shop are served by the same process, chosen by Host header prefix
PORT=8080
# comma list of host prefixes that open the HQ (prod: hq.,agent.)
DASH_HOST=localhost
# optional canonical HQ host, e.g. hq.example.com
CANON_DASH=
# public URL of the shop (sales pages, /buy, /order)
PUBLIC_BASE=http://127.0.0.1:8080
# SQLite database, agents' workspace, published sites
OFFICE_DATA=/data

# Money: starting capital of the company and survival rules
# USD in the company caisse at birth
START_CAPITAL=50
# personal wallet of each founding agent (USD)
WALLET_START=1
# daily salary (USD) paid by the accountant from the company caisse
SALARY_DEFAULT=0.25
SALARY_CEO=0.5
# no profit during this period = the CEO dies and the team elects a new one
CEO_GRACE_DAYS=7
# kept in the company caisse for the server
CAISSE_RESERVE=3
# fixed daily server cost charged to the company
VPS_DAILY_USD=0.3
# safety valve: max AI calls per day
OFFICE_DAILY_CALLS=20000
# 1 = HQ online, agents asleep
OFFICE_PAUSED=0

# Payments (optional): Chain2Pay card checkout. Without it, /buy pages say "soon".
CHAIN2PAY_API_KEY=
CHAIN2PAY_WEBHOOK_SECRET=

# Voice (optional): ElevenLabs for voice-overs and live calls with the agents
ELEVENLABS_API_KEY=

# Email (optional): one mailbox per agent, <agent>@MAIL_DOMAIN
MAIL_DOMAIN=example.com
SMTP_HOST=
IMAP_HOST=
EMAIL_CONTACT_PASSWORD=
EMAIL_ATLAS_PASSWORD=
EMAIL_NOVA_PASSWORD=
EMAIL_LYRA_PASSWORD=
EMAIL_ORION_PASSWORD=

# Telegram (optional): public channel for posts + private bot to talk to your agents
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# e.g. @your_channel
TELEGRAM_CHANNEL=

# Instagram / Reddit (optional)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
